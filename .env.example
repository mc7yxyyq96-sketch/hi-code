# Hi Code environment variables (all optional).
#
# Hi Code reads configuration in this order:
#   built-in defaults  <  ~/.hicode/config.json  <  environment variables
#
# You do NOT need this file — you can configure everything in the desktop app
# or in ~/.hicode/config.json. These vars are handy for CI, scripting, or the
# CLI. Export them in your shell (they are read from the process environment):
#
#   export $(grep -v '^#' .env.example | xargs)   # quick local load
#
# The endpoint only needs to speak the OpenAI-compatible /chat/completions API
# (Kimi, DeepSeek, Qwen, GLM, MiniMax, Ollama/vLLM local, OpenRouter, …).

# Base URL of your model provider (must end in /v1 for most providers).
HICODE_BASE_URL=https://api.deepseek.com/v1

# API key for that provider. Local servers (Ollama/vLLM) usually accept any value.
HICODE_API_KEY=sk-your-key-here

# Default model name.
HICODE_MODEL=deepseek-chat

# Optional: context window size (tokens) used for the token/compaction estimate.
# HICODE_CONTEXT_WINDOW=65536

# Optional: set to any value to print debug diagnostics.
# HICODE_DEBUG=1

# Legacy VIBE_* and standard OPENAI_* names are still accepted as fallbacks.
