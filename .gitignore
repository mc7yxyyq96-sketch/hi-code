# dependencies
node_modules/
test-results/
pnpm-lock.yaml

# build output / artifacts
dist/
release/
*.tsbuildinfo

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# local runtime data (config, sessions, auth, keys) — never commit
.hicode/
.vibe/

# environment / secrets
.env
.env.*
!.env.example

# internal working material — not part of the open-source release.
# Keep the v0.4 entrypoint archive tracked so CI can prove the old root
# entrypoints were moved out of production without reintroducing them.
legacy/*
!legacy/v0.4/
!legacy/v0.4/main.mjs
!legacy/v0.4/renderer.js
!legacy/v0.4/index.html
# Most ad-hoc reports remain local. Program control, task evidence, and the
# explicitly marked historical audit are release-governance artifacts.
reports/*
!reports/program/
!reports/program/**
!reports/evidence/
!reports/evidence/**
!reports/tasks/
!reports/tasks/**
!reports/audit/
reports/audit/*
!reports/audit/README.md
!reports/final-acceptance-historical.md
work/

# editor / OS
.DS_Store
.idea/
.vscode/
*.local
