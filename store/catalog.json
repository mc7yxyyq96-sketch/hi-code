    {
      "id": "mcp-filesystem",
      "kind": "mcp",
      "category": "local",
      "name": "Filesystem MCP",
      "summary": "把当前项目目录暴露给 MCP 工具，适合本地文件读写类工作流。",
      "tags": [
        "mcp",
        "filesystem",
        "文件系统",
        "本地文件"
      ],
      "aliases": [
        "文件系统",
        "本地文件",
        "读写文件",
        "filesystem"
      ],
      "source": "npm",
      "install": {
        "kind": "mcp",
        "server": {
          "name": "filesystem",
          "command": "npx",
          "args": [
            "-y",
            "@modelcontextprotocol/server-filesystem",
            "."
          ]
        }
      }
    },
