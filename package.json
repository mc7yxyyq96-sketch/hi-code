{
  "name": "hi-code",
  "version": "0.6.0-alpha.8",
  "description": "Hi Code — a desktop coding agent for any OpenAI-compatible model.",
  "author": "Hi Code contributors",
  "license": "MIT",
  "homepage": "https://github.com/mc7yxyyq96-sketch/hi-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mc7yxyyq96-sketch/hi-code.git"
  },
  "bugs": {
    "url": "https://github.com/mc7yxyyq96-sketch/hi-code/issues"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "bin": {
    "hicode": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p renderer/tsconfig.json --noEmit && vite build --config vite.renderer.config.ts && tsc -p tsconfig.json && chmod +x dist/index.js",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "check:renderer-types": "tsc -p renderer/tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "node test/feature-tests.mjs",
    "test:feature": "node test/feature-tests.mjs",
    "test:runtime-protocol": "node test/runtime-protocol-tests.mjs",
    "test:runtime-events": "node test/runtime-event-sink-tests.mjs",
    "test:runtime-concurrency": "node test/runtime-concurrency-tests.mjs",
    "test:runtime-clients": "node test/runtime-client-adapter-tests.mjs",
    "test:runtime-stores": "node test/runtime-store-tests.mjs",
    "test:runtime-store-integration": "node test/runtime-store-integration-tests.mjs",
    "test:turn-recovery": "node test/turn-recovery-tests.mjs",
    "test:services": "node test/main-process-services-tests.mjs",
    "test:jobs": "node test/job-center-tests.mjs",
    "test:providers": "node test/provider-tests.mjs",
    "test:model-providers": "node test/model-provider-tests.mjs",
    "test:openai-responses": "node test/openai-responses-provider-tests.mjs",
    "test:anthropic-ollama": "node test/anthropic-ollama-provider-tests.mjs",
    "test:attachment-command": "node test/attachment-command-registry-tests.mjs",
    "test:worktrees": "node test/worktree-runner-tests.mjs",
    "test:arena": "node test/patch-arena-tests.mjs",
    "test:industrial": "node test/industrial-project-tests.mjs",
    "test:domain-packs": "node test/domain-pack-tests.mjs",
    "test:agent-team": "node test/agent-team-tests.mjs",
    "test:industrial-tools": "node test/industrial-tool-tests.mjs",
    "test:quality-gates": "node test/quality-gate-tests.mjs",
    "test:release-builder": "node test/release-builder-tests.mjs",
    "test:samples": "node test/industrial-control-box-sample-tests.mjs",
    "test:dod": "node test/definition-of-done-tests.mjs",
    "test:renderer": "node test/renderer-architecture-tests.mjs",
    "test:app-shell": "vite build --config vite.renderer.config.ts && tsx test/app-shell-tests.ts",
    "test:workspace-shell": "vite build --config vite.renderer.config.ts && tsx test/workspace-shell-tests.ts",
    "test:editor-workbench": "tsx test/editor-workbench-tests.ts",
    "test:entrypoints": "node test/entrypoint-tests.mjs",
    "test:security": "node test/security-baseline.mjs",
    "test:usage": "node test/usage-store-tests.mjs",
    "test:program": "node test/program-control-tests.mjs",
    "test:electron-e2e": "node tests/electron-e2e/run.mjs",
    "test:electron-e2e:update": "node tests/electron-e2e/run.mjs --update-fixtures",
    "test:electron-compatibility": "node test/electron-compatibility-tests.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "scan:dod": "node scripts/scan-dod.mjs",
    "program:baseline": "node scripts/capture-program-baseline.mjs",
    "program:evidence:qa": "node scripts/capture-task-evidence.mjs --task=HC-QA-101",
    "program:evidence:runtime": "node scripts/capture-task-evidence.mjs --task=HC-RUN-201",
    "program:evidence:runtime-store": "node scripts/capture-task-evidence.mjs --task=HC-RUN-202",
    "program:evidence:turn-recovery": "node scripts/capture-task-evidence.mjs --task=HC-RUN-203",
    "program:evidence:electron": "node scripts/capture-task-evidence.mjs --task=HC-PLAT-110",
    "program:evidence:model-provider": "node scripts/capture-task-evidence.mjs --task=HC-PROV-210",
    "program:evidence:openai-responses": "node scripts/capture-task-evidence.mjs --task=HC-PROV-211",
    "program:evidence:anthropic-ollama": "node scripts/capture-task-evidence.mjs --task=HC-PROV-212",
    "program:evidence:attachment-command": "node scripts/capture-task-evidence.mjs --task=HC-RUN-220",
    "program:evidence:app-shell": "node scripts/capture-task-evidence.mjs --task=HC-UI-301",
    "program:evidence:session-workbench": "node scripts/capture-task-evidence.mjs --task=HC-UI-302",
    "program:evidence:editor-workbench": "node scripts/capture-task-evidence.mjs --task=HC-UI-310",
    "program:evidence:alpha7": "node scripts/capture-task-evidence.mjs --task=HC-REL-ALPHA-7",
    "program:evidence:alpha8": "node scripts/capture-task-evidence.mjs --task=HC-REL-ALPHA-8",
    "store:export": "node scripts/export-store-catalog.mjs",
    "check:syntax": "node --check electron/main.mjs && node --check electron/preload.cjs && node --check renderer/renderer.js",
    "check:js": "node --check electron/main.mjs && node --check electron/preload.cjs && node --check renderer/renderer.js",
    "verify": "node scripts/verify.mjs",
    "audit:prod": "node scripts/audit-production.mjs --audit-level=high",
    "audit:high": "npm audit --audit-level=high",
    "release:check": "node scripts/verify.mjs --release",
    "release:checksums": "node scripts/checksum-release.mjs",
    "app": "npm run build && electron .",
    "dist:mac": "npm run build && node scripts/run-electron-builder.mjs --mac dmg",
    "dist:win": "npm run build && node scripts/run-electron-builder.mjs --win --x64",
    "dist:all": "npm run build && node scripts/run-electron-builder.mjs --mac dmg --win --x64"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "chalk": "^5.3.0",
    "diff": "^5.2.0",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "18.3.7",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "npm": "11.9.0",
    "playwright": "^1.61.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "6.2.6"
  },
  "build": {
    "appId": "com.hicode.desktop",
    "productName": "Hi Code",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null
    },
    "dmg": {
      "title": "Hi Code"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-win-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
